class Solution {

    public int totalNQueens(int n) {
        return solve(0, n, new boolean[n],
                     new boolean[2 * n - 1],
                     new boolean[2 * n - 1]);
    }

    public int solve(int row, int n,
                     boolean[] col,
                     boolean[] diag1,
                     boolean[] diag2) {

        // All queens placed
        if (row == n) {
            return 1;
        }

        int count = 0;

        for (int c = 0; c < n; c++) {

            // Check column and diagonals
            if (col[c] || diag1[row + c] || diag2[row - c + n - 1]) {
                continue;
            }

            // Place queen
            col[c] = true;
            diag1[row + c] = true;
            diag2[row - c + n - 1] = true;

            // Move to next row
            count += solve(row + 1, n, col, diag1, diag2);

            // Backtrack
            col[c] = false;
            diag1[row + c] = false;
            diag2[row - c + n - 1] = false;
        }

        return count;
    }
}
